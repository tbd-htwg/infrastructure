# Copy to terraform.tfvars (gitignored) and adjust. Do not commit secrets — the DB password is
# generated by Terraform (random_password) and stored in Secret Manager.
#
# This single file is shared by both stage roots (loaded via -var-file=../terraform.tfvars):
#
#   Stage 1 (assets):           Artifact Registry + GCS frontend bucket; docker push backend;
#                                npm build + gcloud storage rsync SPA.
#   Stage 2 (app runtime):      Cloud SQL (PITR), Cloud Run, HTTPS LB + CDN + managed SSL +
#                                HTTP→HTTPS redirect, Cloud DNS A records, optional Cloud Armor.
#
# Terraform silently ignores variables that a given stage does not declare, so the same file
# works for both roots. backend_image_tag is set by terraform-stage.sh from .terraform-stage-tag
# (or TAG=...), not here.

project_id    = "your-gcp-project-id"
region        = "europe-west1"
artifact_repo = "tbd-tf"
run_sa_name   = "tbd-tf-run"

# --- Cloud SQL (production profile: automated backups + PITR always on) ---
db_instance_name        = "tbd-tf-pg"
db_name                 = "tbd-tf"
db_user                 = "tbd-tf_app"
db_password_secret_name = "tbd-tf-db-password"
sql_tier                = "db-custom-1-3840"
sql_disk_size_gb        = 10
sql_deletion_protection = false    # flip to false + `terraform-stage.sh 2` once before --destroy
sql_high_availability   = false   # set true for REGIONAL HA (synchronous standby)

# --- Public hostnames (both become A records to the same HTTPS LB IP) ---
frontend_hostname      = "tf.tbd-htwg.de"
cloud_run_api_hostname = "api.tf.tbd-htwg.de"

# --- Frontend static site (stage 1 bucket, stage 2 LB/CDN) ---
frontend_url_map_name         = "tbd-tf-lb"
frontend_bucket_force_destroy = false    # flip to true + `terraform-stage.sh 1` once before --destroy

# --- Cloud Run API (stage 2; image tag comes from terraform-stage.sh) ---
cloud_run_backend_service_name = "tbd-tf-backend"
cloud_run_min_instances        = 0       # 1+ to keep a warm instance (avoids cold starts)
cloud_run_max_instances        = 10
cloud_run_cpu                  = "1"
cloud_run_memory               = "1Gi"
cors_allowed_origins           = "https://tf.tbd-htwg.de"

# --- Cloud DNS (A records only; zone itself is not managed here) ---
dns_managed_zone_name    = "tbd-example-zone"
manage_cloud_dns_records = true

# --- Optional Cloud Armor (WAF + per-IP rate limiting on the API backend) ---
enable_cloud_armor         = false
cloud_armor_rate_limit_rps = 600   # requests per minute per client IP before throttle

# --- Optional: Cloud Run uses remote Elasticsearch (IaaS tier + Caddy /es) instead of Lucene ---
# Apply terraform_iaas first; use outputs `elasticsearch_secret_ids` and `tier_hostnames`.
# Grant the Cloud Run runtime SA secretAccessor on that secret (terraform_iaas can do this via
# elasticsearch_secret_accessor_members), then set for example:
#
# remote_elasticsearch = {
#   hosts              = "small-iaas.tbd-htwg.de:443"
#   password_secret_id = "tbd-iaas-elasticsearch-small"
#   protocol           = "https"
#   path_prefix        = "/es"
#   username           = "elastic"
# }
