# Copy this file to gcp.env and fill values before running setup/deploy scripts.
# Required GCP project settings
PROJECT_ID=project-9118634e-c9f1-4f29-804
# Optional: used only when setup script needs to create a new project
APP_NAME="TBD - CloudAppDev"
REGION=europe-west1

# Artifact Registry
ARTIFACT_REPO=tripplanning

# Cloud Run
BACKEND_SERVICE=tripplanning-backend
FRONTEND_SERVICE=tripplanning-frontend
RUN_SA_NAME=tripplanning-run

# Public URLs / domains
FRONTEND_DOMAIN=paas.tbd-htwg.de
BACKEND_DOMAIN=api.paas.tbd-htwg.de

# Comma-separated list for backend CORS policy
CORS_ALLOWED_ORIGINS=https://paas.tbd-htwg.de,https://iaas.tbd-htwg.de

# Cloud SQL (PostgreSQL)
DB_INSTANCE=tripplanning-pg
DB_NAME=tripplanning
DB_USER=tripplanning_app
# Set this only in your local gcp.env (never commit real secret values)
DB_PASSWORD=change_me

# Secret Manager secret name for DB password
DB_PASSWORD_SECRET=tripplanning-db-password


