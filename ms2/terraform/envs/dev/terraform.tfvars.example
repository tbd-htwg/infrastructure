project_id = "project-1234567890"
region     = "europe-west1"

dns_zone = {
  name        = "tbd-htwg-zone"
  domain      = "tbd-htwg.de."
  description = "Tenant domains for GKE."
}

network = {
  name                    = "tripplanning-vpc"
  subnet_name             = "tripplanning-subnet"
  subnet_cidr             = "10.10.0.0/20"
  pods_secondary_name     = "pods"
  pods_secondary_cidr     = "10.20.0.0/16"
  services_secondary_name = "services"
  services_secondary_cidr = "10.30.0.0/20"
}

gke = {
  cluster_name           = "tripplanning-gke"
  release_channel        = "REGULAR"
  private_cluster        = true
  master_ipv4_cidr_block = "172.16.0.0/28"
}


kms = {
  enabled         = false
  location        = "europe-west1"
  key_ring_name   = "tripplanning-keyring"
  crypto_key_name = "tripplanning-key"
}

firestore = {
  enabled     = true
  database_id = "tbd-firestore"
  location_id = "europe-west1"
}

frontend = {
  domain     = "k8s.tbd-htwg.de"
  enable_cdn = false
  # /api/* routes through an internet NEG to the shared Standard api-router LoadBalancer.
  # Leave api_backend_neg_self_links unset unless you intentionally manage GKE standalone NEG names.
  api_health_check_path = "/healthz"
  api_health_check_port = 8088
}

github_wif = {
  owner                = "GITHUB_ORG"
  repo                 = "frontend"
  pool_id              = "github-actions"
  provider_id          = "github-oidc"
  service_account_name = "frontend-deployer"
}

backend_wif = {
  owner       = "GITHUB_ORG"
  repo        = "backend"
  provider_id = "github-oidc-backend"
}

infra_wif = {
  owner                = "GITHUB_ORG"
  repo                 = "infrastructure"
  provider_id          = "github-oidc-infrastructure"
  service_account_name = "terraform-deployer"
}

standard_cloudsql = {
  enabled           = true
  instance_name     = "tripplanning-standard"
  tier              = "db-custom-1-3840"
  disk_size_gb      = 20
  availability_type = "ZONAL"
  private_ip_range  = "10.40.0.0"
}

platform_cloudsql = {
  instance_name     = "tripplanning-platform"
  database_name     = "tripplanning_platform"
  user_name         = "tripplanning_platform"
  tier              = "db-f1-micro"
  disk_size_gb      = 10
  availability_type = "ZONAL"
}

standard_load_balancer = {
  name = "tripplanning-standard-lb-ip"
}

standard_tenants = {
  acme = {
    hostnames = ["acme.k8s.tbd-htwg.de"]
    identity_platform = {
      display_name           = "acme-standard"
      tenant_id              = "acme-standard"
      email_password_enabled = true
      mfa_enabled            = false
    }
    database = {
      name      = "tripplanning_std_acme"
      user_name = "tripplanning_app_acme"
    }
    frontend = {
      bucket_prefix = "standard/acme"
      brand_name    = "Acme Travel"
      color_scheme  = "blue"
      brand_icon    = "assets/brand-icon.png"
    }
    storage = {
      images_prefix = "standard/acme"
    }
    search = {
      index_name = "tripentity-acme"
    }
    cache = {
      key_prefix = "std:acme"
    }
  }
}

enterprise_tenants = {
  globex = {
    namespace = "tripplanning-ent-globex"
    hostnames = ["globex.enterprise.k8s.tbd-htwg.de"]
    identity_platform = {
      display_name           = "globex-enterprise"
      tenant_id              = "globex-enterprise"
      email_password_enabled = true
      mfa_enabled            = true
    }
    database = {
      instance_name     = "tripplanning-ent-globex"
      name              = "tripplanning"
      user_name         = "tripplanning_app"
      # Low-idle development defaults. Increase the tier explicitly for
      # production workloads; Cloud SQL does not scale through Kubernetes HPA.
      tier              = "db-f1-micro"
      disk_size_gb      = 10
      disk_autoresize   = true
      availability_type = "ZONAL"
    }
    frontend = {
      bucket_prefix = "enterprise/globex"
      brand_name    = "Globex Travel"
      color_scheme  = "green"
      brand_icon    = "assets/brand-icon.png"
    }
    storage = {
      image_bucket_name = "PROJECT_ID-globex-images-bucket"
    }
    search = {
      release_name = "opensearch-globex"
    }
    cache = {
      dedicated = true
    }
  }
}

flux_bootstrap = {
  namespace    = "flux-system"
  manifest_dir = "../../../gitops/clusters/dev/flux-system"
  git_username = "git"
}

# Only needed for a private Git repository. Prefer passing it via
# TF_VAR_flux_bootstrap_git_password or a local uncommitted tfvars file.
# flux_bootstrap_git_password = "REPLACE_WITH_GITHUB_TOKEN"

# Optional: if set, Terraform writes this token into Secret Manager as
# tripplanning-platform-github-dispatch-token for platform-service tenant creation.
# Prefer TF_VAR_platform_github_dispatch_token or an uncommitted secrets.auto.tfvars file.
# platform_github_dispatch_token = "REPLACE_WITH_GITHUB_DISPATCH_TOKEN"
