# Copy to secrets.auto.tfvars (gitignored). Values from Google Auth Platform console
# or: curl -H "Authorization: Bearer $(gcloud auth print-access-token)" \
#       -H "x-goog-user-project: tbd-cloudappdev" \
#       "https://identitytoolkit.googleapis.com/v2/projects/tbd-cloudappdev/defaultSupportedIdpConfigs/google.com"

google_oauth = {
  client_id     = "YOUR_CLIENT_ID.apps.googleusercontent.com"
  client_secret = "YOUR_CLIENT_SECRET"
  enabled       = true
}
