%% Canonical copy lives in STATE.md §2 (C2 — Containers).
C4Container
    title Container Diagram — Trip Planner ms2 (deployed GKE dev)

    Person(user, "Traveller", "Uses web app; Locust uses same host as SPA")

    System_Boundary(edge, "Edge") {
        Container(spa, "Web Application", "React, Vite", "Static SPA on GCS; /api/* via frontend LB")
        Container(apiRouter, "api-router", "nginx", "Path-based API proxy to trip / social / external-info")
        Container(gateway, "GKE Gateway", "Gateway API", "Optional: api.k8s.tbd-htwg.de (curl/Swagger)")
    }

    System_Boundary(apps, "Application Layer (tripplanning-free)") {
        Container(trip, "trip-service", "Spring Boot", "Trips, users, auth, search, GCS URLs")
        Container(social, "social-service", "Spring Boot", "Likes and comments")
        Container(ext, "external-info-service", "Spring Boot WebFlux", "Places, weather, warnings, Viator")
    }

    System_Boundary(persist, "Persistence") {
        ContainerDb(pg, "PostgreSQL", "In-cluster SS", "Trips, users, google_places cache")
        ContainerDb(os, "OpenSearch", "In-cluster SS", "Hibernate Search index tripentity")
        ContainerDb(valkey, "Valkey", "In-cluster", "Feed cache, search coordination, API cache")
        ContainerDb(fs, "Firestore", "Managed GCP", "Likes and comments (tbd-firestore)")
        ContainerDb(gcs, "GCS images", "Managed GCP", "Image blobs")
    }

    System_Ext(mapsApi, "Maps JavaScript API", "Trip detail map (browser)")
    System_Ext(routesApi, "Google Routes API", "Transport polylines (browser)")
    System_Ext(placesApi, "Google Places API", "Place search and details")
    System_Ext(meteoApi, "Open-Meteo", "Weather")
    System_Ext(aaApi, "Auswaertiges Amt", "Travel warnings")
    System_Ext(viatorApi, "Viator API", "Accommodation tours")

    Rel(user, spa, "Uses", "HTTPS")
    Rel(spa, apiRouter, "Same-origin /api/*", "HTTPS")
    Rel(user, gateway, "Optional direct API", "HTTPS")
    Rel(gateway, apiRouter, "HTTPRoute")
    Rel(gateway, trip, "HTTPRoute")
    Rel(gateway, social, "HTTPRoute")
    Rel(gateway, ext, "HTTPRoute")
    Rel(apiRouter, trip, "Proxies")
    Rel(apiRouter, social, "Proxies social paths")
    Rel(apiRouter, ext, "Proxies /api/v2/external")

    Rel(spa, mapsApi, "HTTPS")
    Rel(spa, routesApi, "HTTPS")

    Rel(trip, pg, "JPA / Flyway")
    Rel(trip, os, "Hibernate Search")
    Rel(trip, valkey, "Cache + index lock")
    Rel(trip, gcs, "Signed URLs via WI")
    Rel(trip, social, "Internal HTTP")
    Rel(trip, ext, "location-pack")

    Rel(social, fs, "Firestore API")
    Rel(social, valkey, "Community cache")
    Rel(social, trip, "Validate trips")

    Rel(ext, valkey, "Reactive cache")
    Rel(ext, placesApi, "HTTPS")
    Rel(ext, meteoApi, "HTTPS")
    Rel(ext, aaApi, "HTTPS")
    Rel(ext, viatorApi, "HTTPS")

    UpdateElementStyle(trip, $bgColor="#2dd4bf", $fontColor="#ffffff")
    UpdateElementStyle(social, $bgColor="#2dd4bf", $fontColor="#ffffff")
    UpdateElementStyle(ext, $bgColor="#2dd4bf", $fontColor="#ffffff")
    UpdateElementStyle(apiRouter, $bgColor="#0f172a", $fontColor="#ffffff", $borderColor="#2dd4bf")
