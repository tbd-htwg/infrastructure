# Copy to .env and fill in. dev-lifecycle.sh loads .env from this directory automatically.
# JWT must be ≥ 32 characters (required for ./dev-lifecycle.sh secrets).
# Optional: AUTO_APPROVE=false   # prompt for terraform apply/destroy (default is true)
# Optional: AUTO_CONTINUE=false # after reset teardown, prompt before setup (default is true)
# Optional: API_HOST=api.k8s.tbd-htwg.de
# Optional: FRONTEND_HOST=k8s.tbd-htwg.de
# Optional: ACME_EMAIL=you@example.com   # Let's Encrypt (cluster-issuer)
# Optional: SKIP_TLS=true / SKIP_DNS_WIRE=true   # disable HTTPS or terraform DNS wiring
JWT_SECRET=replace-with-your-jwt-secret-min-32-chars!!