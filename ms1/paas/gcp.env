# Copy this file to gcp.env and fill values before running setup/deploy scripts.
# Required GCP project settings
PROJECT_ID=project-9118634e-c9f1-4f29-804
# Optional: used only when setup script needs to create a new project
APP_NAME="TBD - CloudAppDev"
REGION=europe-west1

# Artifact Registry
ARTIFACT_REPO=tripplanning

# Cloud Run
BACKEND_SERVICE=tripplanning-backend
FRONTEND_SERVICE=tripplanning-frontend
RUN_SA_NAME=tripplanning-prod-be-rt

# Public URLs / domains
FRONTEND_DOMAIN=paas.tbd-htwg.de
BACKEND_DOMAIN=api.paas.tbd-htwg.de


# Comma-separated list for backend CORS policy
CORS_ALLOWED_ORIGINS=https://paas.tbd-htwg.de

# Cloud SQL (PostgreSQL)
DB_INSTANCE=tripplanning-pg
DB_NAME=tripplanning
DB_USER=tripplanning_app
# Set this only in your local gcp.env (never commit real secret values)
DB_PASSWORD=8f1938e8-db15-4c2d-b490-9f1e8ffd2373

# Secret Manager secret name for DB password
DB_PASSWORD_SECRET=tripplanning-db-password

GCP_RUN_SA_EMAIL=${RUN_SA_NAME}@${PROJECT_ID}.iam.gserviceaccount.com

# Phase 1/2 IAM scripts
# ENVIRONMENT must be one of: dev, prod
ENVIRONMENT=prod
APP_PREFIX=tripplanning

# Optional for apply-service-accounts.sh (auto-derived from BACKEND_SERVICE if empty).
# Example derivation for prod if BACKEND_SERVICE=tripplanning-backend:
# FRONTEND_BUCKET_NAME=${PROJECT_ID}-frontend-bucket
FRONTEND_BUCKET_NAME=

# Optional toggles for additional scoped identities
ENABLE_IDENTITY_ADMIN_SA=true
ENABLE_FIRESTORE_MIGRATOR_SA=false

# Optional hardening controls
# RUN_DEPLOY_ROLE can be roles/run.admin (default) or roles/run.developer
RUN_DEPLOY_ROLE=roles/run.admin
# OPTIONAL_SECRET_NAMES can include extra backend runtime secrets (comma-separated)
# OPTIONAL_SECRET_NAMES=tripplanning-es-password,tripplanning-third-party-api-key
OPTIONAL_SECRET_NAMES=tbd-es-gateway-elastic-password

# Optional Artifact Registry scoping. If ARTIFACT_REPO is set, writer is bound on that repo.
# If empty, writer is granted at project level.
# ARTIFACT_REPO=tripplanning

# Optional custom role id for frontend cache invalidation permission.
ENABLE_CUSTOM_CDN_INVALIDATOR_ROLE=true
CUSTOM_CDN_ROLE_ID=tripplanningFrontendCdnInvalidator

# GitHub Actions keyless auth (Workload Identity Federation)
GITHUB_OWNER=tbd-htwg
BACKEND_REPO=backend
FRONTEND_REPO=frontend
WIF_POOL_ID=github-actions
WIF_PROVIDER_ID=github-oidc
DEV_ALLOWED_REFS=refs/heads/develop,refs/heads/staging
PROD_ALLOWED_REFS=refs/heads/main
DEV_ALLOWED_GH_ENVS=develop,staging
PROD_ALLOWED_GH_ENVS=production