# Copy to terraform.tfvars (gitignored) and set paths to local secrets.
#
# Run with a local Terraform binary:
#   terraform init && terraform plan && terraform apply
#
# Or with Docker (mounts parent infrastructure/ so ../docker-compose.yml and ../.env resolve):
#   chmod +x run-terraform-docker.sh
#   ./run-terraform-docker.sh init
#   ./run-terraform-docker.sh plan
#   ./run-terraform-docker.sh apply
#
# After apply: app and API stay on https://<tier>-iaas.<suffix>/ (same as today).
#
# If VMs exist but Compose is not up: terraform apply (uploads bootstrap-compose.sh + metadata),
# then per VM either `gcloud compute instances reset <name> --zone=...` or SSH and:
#   sudo gsutil cp gs://<assets_bucket>/bootstrap-compose.sh /tmp/ && sudo bash /tmp/bootstrap-compose.sh
# See output compose_bootstrap_hint. Caddy needs the SA in Secret Manager to manage DNS for the zone.
# Elasticsearch on the VM is only at http://elasticsearch:9200 (not exposed on the public hostname).
# For Cloud Run remote search, use ../terraform_es (HTTPS /es/) and stage2 remote_elasticsearch.

project_id = "your-gcp-project-id"
# GCE zone must lie in the same region as PaaS (../terraform region) and terraform_es.
region     = "europe-west1"
zone       = "europe-west1-b"

# Hostnames: small-iaas.tbd-htwg.de, medium-iaas.tbd-htwg.de, ...
iaas_domain_suffix = "tbd-htwg.de"

# Same managed zone name you use for PaaS Terraform (zone must already exist).
dns_managed_zone_name    = "tbd-example-zone"
manage_cloud_dns_records = true

instance_name_prefix = "tbd-iaas"
network_tag          = "tripplanning-iaas"

# Optional: allow SSH from IAP for troubleshooting
# allow_ssh_ingress = true
# ssh_source_ranges = ["35.235.240.0/20"]

# Local files read at apply time; content lands in Secret Manager (and in state).
# The same .env is used for every tier; startup removes CADDY_DOMAIN / GCP_PROJECT /
# GOOGLE_APPLICATION_CREDENTIALS and appends the right hostname (e.g. small-iaas...) per VM.
tripplanning_env_file = "../.env"
gcp_sa_json_file      = "../gcp-sa.json"

# Private images on ghcr.io: GitHub username + file containing a PAT (read:packages).
# ghcr_username     = "mygithubuser"
# ghcr_token_file     = "../github-pat-ghcr.txt"

# If your compose images are in this project's Artifact Registry, list repo ids:
# artifact_registry_repository_ids = ["tbd-tf"]

# Grant Cloud Run runtime SA access to tier Elasticsearch passwords (same project), e.g.:
# elasticsearch_secret_accessor_members = [
#   "serviceAccount:tbd-tf-run@YOUR_PROJECT_ID.iam.gserviceaccount.com",
# ]

# Optional: larger boot disk if images + ES fill the default (40 GB).
# boot_disk_size_gb = 50

# Machine types: e2-standard-N has N vCPUs (1→4 GiB RAM, 2→8 GiB, 4→16 GiB).
tiers = {
  small = {
    machine_type = "e2-standard-1"
    es_java_opts = "-Xms512m -Xmx512m"
  }
  medium = {
    machine_type = "e2-standard-2"
    es_java_opts = "-Xms1g -Xmx1g"
  }
  large = {
    machine_type = "e2-standard-4"
    es_java_opts = "-Xms2g -Xmx2g"
  }
}
