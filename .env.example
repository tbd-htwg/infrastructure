# Copy to `.env` in this directory and fill in values.
# Docker Compose reads `.env` automatically for ${VAR} substitution in docker-compose.yml.
# See: https://docs.docker.com/compose/environment-variables/set-environment-variables/
#
# IaaS (terraform_iaas): upload this file to Secret Manager as the shared env payload. Do not rely
# on CADDY_DOMAIN / GCP_PROJECT / GOOGLE_APPLICATION_CREDENTIALS here for multi-tier VMs — bootstrap
# strips those keys and re-appends the correct hostname per instance (e.g. small-iaas.tbd-htwg.de).
# For ghcr.io private images use terraform_iaas variables ghcr_username + ghcr_token_file (not GHCR_TOKEN here).

CADDY_DOMAIN=iaas.tbd-htwg.de
GCP_PROJECT=your-gcp-project-id
# Path to service account JSON inside the container (mount the file in docker-compose.yml if used)
GOOGLE_APPLICATION_CREDENTIALS=
POSTGRES_DB=tripplanning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
