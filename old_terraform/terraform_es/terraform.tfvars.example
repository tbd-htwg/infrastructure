# Copy to terraform.tfvars (gitignored) and edit.

project_id = "your-gcp-project"
# Same region as PaaS (../terraform) and same zone as IaaS VMs (../terraform_iaas).
region     = "europe-west1"
zone       = "europe-west1-b"

# Public hostname for this VM (Terraform creates an A record when manage_cloud_dns_records is true).
elasticsearch_fqdn = "es.tbd-htwg.de"

dns_managed_zone_name      = "tbd-example-zone"
manage_cloud_dns_records   = true

instance_name     = "tbd-es-gateway"
network_tag       = "tripplanning-es-gateway"
machine_type      = "e2-standard-2"
boot_disk_size_gb = 50
es_java_opts      = "-Xms2g -Xmx2g"

# SA JSON with permission to manage Cloud DNS for ACME DNS-01 (e.g. roles/dns.admin on the zone/project).
gcp_sa_json_file = "../path/to/caddy-dns-sa.json"

# Cloud Run (or others) that must read the elastic password secret:
# secret_accessor_members = [
#   "serviceAccount:YOUR_CLOUD_RUN_RUNTIME@your-gcp-project.iam.gserviceaccount.com",
# ]

# Optional: private ghcr images
# ghcr_username   = "your-github-user"
# ghcr_token_file = "../github-pat-ghcr.txt"

# Optional SSH from IAP
# allow_ssh_ingress = true
